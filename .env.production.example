APP_NAME=SIMONTOK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-production.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simontok
DB_USERNAME=simontok
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Global SSO baru
SIMONTOK_API_ENABLED=true
SIMONTOK_API_URL=https://apisso.bkkjateng.co.id
SIMONTOK_API_APP=nora
SIMONTOK_API_APP_TOKEN=
SIMONTOK_API_TIMEOUT=10
SIMONTOK_API_VERIFY_SSL=true

# Login lokal harus mati di production
SSO_LOCAL_BYPASS=false
SSO_LOCAL_PASSWORD=

# Data rekening dan cabang dibaca langsung dari API
CORE_PROVIDER=remote
CORE_READ_MODEL=direct

# Fitur staging/UAT tidak digunakan di production
CORE_STAGING_TTL_MINUTES=60
SEED_DEMO_DATA=false
UAT_MODE=false
UAT_EMERGENCY_ONLY=false

# Opsional: hanya isi jika akun darurat benar-benar diaktifkan
SSO_EMERGENCY_LOGIN=
SSO_EMERGENCY_ALERT_EMAIL=
EMERGENCY_ACCOUNT_PASSWORD=

# Hanya dipakai saat menjalankan seeder secara sengaja
SEEDER_DEFAULT_PASSWORD=
